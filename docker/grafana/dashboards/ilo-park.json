      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ilo_exporter_last_run_duration_seconds",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "queryType": "range"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 32
      }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Ошибки коллекторов (1 = ошибка)",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (target, collector) ({__name__=~\"ilo_.*_collect_success\", target=~\"$target\"}) == bool 0",
          "legendFormat": "{{target}}/{{collector}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "queryType": "range"
